---
import Logo from './Logo.astro';
import { ArrowDownIcon } from '@lucide/astro';

interface Props {
  /* `sections` shows the in-page anchors, which only exist on the home page.
     Everywhere else the nav is just a way back home. */
  variant?: 'sections' | 'home';
}

const { variant = 'home' } = Astro.props;

const navLinks =
  variant === 'sections'
    ? [
        ['Articles', '/#articles'],
        ['Projects', '/#projects'],
        ['Music', '/#music'],
        ['About', '/#about'],
      ]
    : [['Home', '/']];
---

<div id="site-nav" class="relative top-0 z-10 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] data-[floating=true]:fixed data-[floating=true]:right-0 data-[floating=true]:left-0 md:data-[floating=true]:py-2">
  <nav class="group flex items-center justify-center overflow-hidden bg-[#3a332f] shadow-lg transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] data-[floating=true]:bg-accent md:data-[floating=true]:mx-auto md:data-[floating=true]:w-max md:data-[floating=true]:rounded-sm">
    <a
      class="relative block px-2 py-1.5 text-white/60 after:absolute after:top-1 after:-right-1 after:bottom-1 after:w-px after:bg-white after:content-[''] hover:text-white [&>svg]:size-5"
      aria-hidden="true"
      href={variant === 'sections' ? '#' : '/'}
    >
      <Logo />
    </a>
    {
      navLinks.map(([label, href]) => {
        return (
          <a
            class:list={[
              'group inline-flex items-center gap-1 px-4 py-2 text-[0.79rem] tracking-[0.04em] text-white uppercase hover:bg-white hover:text-[#3a332f] data-[floating=true]:hover:text-accent',
            ]}
            href={href}
          >
            {label}
            {variant === 'sections' ? (
              <span
                aria-hidden="true"
                class="inline-block -translate-y-full opacity-0 transition-[translate,rotate] duration-100 group-hover:translate-y-0 group-hover:opacity-100 group-hover:duration-300 data-[scroll-direction=up]:rotate-180"
                data-scroll-arrow
              >
                <ArrowDownIcon class="size-4" />
              </span>
            ) : null}
          </a>
        );
      })
    }
  </nav>
</div>

<script>
  const nav = document.getElementById('site-nav');
  const navBar = nav?.querySelector<HTMLElement>('nav');
  if (nav) {
    const setFloating = () => {
      const floatAfter = nav.offsetHeight + window.innerHeight * 0.05;
      const floating = window.scrollY > floatAfter ? 'true' : 'false';
      nav.dataset.floating = floating;
      if (navBar) navBar.dataset.floating = floating;
      nav.querySelectorAll<HTMLElement>('a').forEach((link) => {
        link.dataset.floating = floating;
      });
    };

    const updateScrollDirections = () => {
      const links = nav.querySelectorAll<HTMLAnchorElement>('a[href*="#"]');

      for (const link of links) {
        const url = new URL(link.href);
        const target = url.hash ? document.querySelector(url.hash) : null;
        const arrow = link.querySelector<HTMLElement>('[data-scroll-arrow]');
        if (!target || !arrow || url.pathname !== location.pathname) continue;

        arrow.dataset.scrollDirection = target.getBoundingClientRect().top < 0 ? 'up' : 'down';
      }
    };

    const handleScroll = () => {
      setFloating();
      updateScrollDirections();
    };

    setFloating();
    updateScrollDirections();
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', updateScrollDirections);
    window.addEventListener('hashchange', updateScrollDirections);
  }
</script>
